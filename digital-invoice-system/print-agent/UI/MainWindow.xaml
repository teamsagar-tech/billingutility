<Window x:Class="PrintAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetailNode Print Dispatcher" 
        Height="470" Width="440" 
        WindowStartupLocation="CenterScreen" 
        Topmost="True" 
        ResizeMode="NoResize"
        Background="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Bill Info Pill -->
            <RowDefinition Height="Auto" /> <!-- Customer Mobile Input -->
            <RowDefinition Height="*" />    <!-- Action Buttons -->
            <RowDefinition Height="Auto" /> <!-- Footer Timer / Status -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="RetailNode Billing Dispatcher" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A" />
            <TextBlock Text="Select delivery method for this invoice" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
        </StackPanel>

        <!-- 2. Bill Summary Badge -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Name="txtStoreName" Text="Deepak Sarees" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                    <TextBlock Name="txtInvoiceNo" Text="Invoice: #DS-2026-8842" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Name="txtBillTotal" Grid.Column="1" Text="₹8,800.00" FontWeight="ExtraBold" FontSize="18" Foreground="#0F766E" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. Customer Mobile Field -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Customer WhatsApp Number:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
            <TextBox Name="txtMobile" Height="36" FontSize="15" FontWeight="Bold" Padding="8,5" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" VerticalContentAlignment="Center" KeyDown="txtMobile_KeyDown" />
        </StackPanel>

        <!-- 4. The 3 Primary Channel Actions -->
        <StackPanel Grid.Row="3">
            <!-- Option 1: Send Digitally -->
            <Button Name="btnSendDigital" Background="#0F766E" Click="btnSendDigital_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="[1] Send Digitally (WhatsApp Only)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Save paper, dispatch instant WhatsApp digital bill" FontSize="10.5" Foreground="#CCFBF1" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#115E59" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Press [1] or [D]" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Option 2: Send to Printer -->
            <Button Name="btnPrintOnly" Background="#475569" Click="btnPrintOnly_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="[2] Send to Printer (Paper Only)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Print physical slip without sending WhatsApp" FontSize="10.5" Foreground="#E2E8F0" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#334155" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Press [2] or [P]" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Option 3: Send on Both Channels (DEFAULT) -->
            <Button Name="btnBothChannels" Background="#1D4ED8" Click="btnBothChannels_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,10" BorderBrush="#3B82F6" BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="[3] Send on Both Channels (Print + WhatsApp)" FontWeight="ExtraBold" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text="Paper receipt + branded digital receipt with loyalty" FontSize="10.5" Foreground="#DBEAFE" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1E40AF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Enter / [3]" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 5. Status & Countdown Timer -->
        <Grid Grid.Row="4" Margin="0,6,0,0">
            <TextBlock Name="txtTimer" Text="Auto-executing default [Both Channels] in 5s... (Press Space to pause)" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Left" />
            <TextBlock Text="Esc to Cancel" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
