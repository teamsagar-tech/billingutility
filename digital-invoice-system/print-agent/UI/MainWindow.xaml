<Window x:Class="PrintAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digital Bill Interceptor" Height="300" Width="400" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="Smart Digital Receipt" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        
        <TextBlock Text="Customer Mobile Number:" />
        <TextBox Name="txtMobile" Margin="0,5,0,10" Padding="5" FontSize="16" />

        <TextBlock Text="SaaS API Token:" />
        <TextBox Name="txtApiToken" Margin="0,5,0,20" Padding="5" FontSize="12" Foreground="Gray" Text="sk_live_..." />

        <TextBlock Name="txtBillInfo" Text="Bill Total: - | Invoice: -" Margin="0,0,0,20" Foreground="Gray"/>
        
        <Button Name="btnSendDigital" Content="Send Digitally Only" Padding="10" Margin="0,0,0,10" Background="#3b82f6" Foreground="White" Click="btnSendDigital_Click"/>
        <Button Name="btnSendAndPrint" Content="Send &amp; Print Paper" Padding="10" Click="btnSendAndPrint_Click"/>
    </StackPanel>
</Window>
